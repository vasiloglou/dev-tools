+def reread_entry(project, text):
+    path = project / "docs/components/COMPONENTS.md"
+    path.write_text(path.read_text().replace("- modules: src/widget/sizes.py\n",
+                                             "- modules: src/widget/sizes.py\n- reread: %s\n" % text))
