++        if not record:
++            continue
++        meta, name = record.split(b"\t", 1)
++        mode, kind, sha = meta.decode().split()
++        if kind == "blob":
++            entries.append((mode, sha, os.fsdecode(name)))
++    batch = subprocess.run(["git", "-C", str(checkout), "cat-file", "--batch"],
