+    core.sizes with the index regenerated. `sizes` is added to the core.sizes entry before the commit."""
+    (project / "src/widget/sizes.py").write_text('"""Sizes."""\n')
+    (project / "src/widget/rows.py").write_text('"""Rows."""\n')
