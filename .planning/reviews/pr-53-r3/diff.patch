+    assert tool(project, "write", script=INDEX)[0] == 0
+    code, lines, out = rereads(project)
+    assert code == 0, out
+    assert lines == ["reread: core.sizes (entry not edited): src/widget/sizes.py; "
+                     "new public names not in does or verbs: parse"], out
